<div class="mezz-paperdoll">

<img class="pd-bg" src="{{actor.img}}">

{{#each paperdollSlots as |slot key|}}

<div class="pd-slot"
     data-slot="{{key}}"
     style="left:{{slot.x}}px; top:{{slot.y}}px;">

{{#if slot.item}}
<img src="{{slot.item.img}}">
{{else}}
<span class="pd-label">{{slot.label}}</span>
{{/if}}

</div>

{{/each}}

</div>